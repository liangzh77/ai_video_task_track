// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum MediaType {
  IMAGE
  VIDEO
}

model User {
  id             String   @id @default(cuid())
  username       String   @unique
  password       String
  role           Role     @default(USER)
  canCRUD        Boolean  @default(false)
  canApprove     Boolean  @default(false)
  canViewGallery Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  submittedTasks Task[] @relation("TaskSubmitter")
  createdTasks   Task[] @relation("TaskCreator")
  galleryItems   GalleryItem[] @relation("GalleryItemCreator")

  @@map("users")
}

model Template {
  id        String   @id @default(cuid())
  name      String
  items     Json     @default("[]") // Array of { type: 'image' | 'text', content: string }
  videoUrl        String?  // 视频URL，存储在腾讯COS
  bridgeUploaded  Boolean  @default(false) // 是否已上传到桥段素材库
  notes     String   @default("") // 模板备注
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks Task[]

  @@index([order])
  @@map("templates")
}

model Task {
  id            String    @id @default(cuid())
  templateId    String
  items         Json      @default("[]") // Array of { type: 'image' | 'text', content: string }
  videoUrl        String?   // 视频URL，存储在腾讯COS
  bridgeUploaded  Boolean   @default(false) // 是否已上传到桥段素材库
  materialId    String    @default("")
  notes         String    @default("")
  feedback      String    @default("") // 反馈
  submitterId   String?   // 提交者ID
  isSubmitted   Boolean   @default(false)
  isApproved    Boolean   @default(false)
  creatorId     String?
  order         Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  template     Template      @relation(fields: [templateId], references: [id], onDelete: Cascade)
  submitter    User?         @relation("TaskSubmitter", fields: [submitterId], references: [id], onDelete: SetNull)
  creator      User?         @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  dailyMetrics DailyMetrics[]

  @@index([templateId])
  @@index([templateId, order])
  @@index([submitterId])
  @@index([creatorId])
  @@index([materialId])
  @@map("tasks")
}

// 每日数据指标
model DailyMetrics {
  id             String   @id @default(cuid())
  taskId         String
  date           DateTime @db.Date // 数据日期
  cost           Float    @default(0) // 消耗
  impressions    Int      @default(0) // 展示数
  clicks         Int      @default(0) // 点击数
  clickRate      Float    @default(0) // 点击率(%)
  cpm            Float    @default(0) // 平均千次展现费用(元)
  conversions    Int      @default(0) // 转化数
  conversionCost Float    @default(0) // 转化成本
  roi            Float    @default(0) // ROI
  activations    Int      @default(0) // 激活数
  dailyPayment   Float    @default(0) // 计费当日付费金额
  materialScore  Float    @default(0) // 素材评估
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, date]) // 每个任务每天只有一条记录
  @@index([taskId])
  @@index([date])
  @@map("daily_metrics")
}

// Gallery 作品墙
model GalleryItem {
  id         String     @id @default(cuid())
  type       MediaType
  url        String
  sourceUrl  String?    // 原始素材URL（对比展示时的"前"）
  sourceType MediaType? // 原始素材类型
  prompt     String     @default("")
  creatorId  String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  creator User?            @relation("GalleryItemCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  tags    GalleryItemTag[]

  @@index([creatorId])
  @@index([type])
  @@index([createdAt])
  @@map("gallery_items")
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  items GalleryItemTag[]

  @@map("tags")
}

model GalleryItemTag {
  galleryItemId String
  tagId         String

  galleryItem GalleryItem @relation(fields: [galleryItemId], references: [id], onDelete: Cascade)
  tag         Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([galleryItemId, tagId])
  @@index([tagId])
  @@map("gallery_item_tags")
}
